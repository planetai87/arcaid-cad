{
    "server": {
        "name": "arcaid-cad",
        "version": "3.0.0",
        "transport": "stdio",
        "host": "127.0.0.1",
        "port": 8000
    },
    "cad": {
        "type": "AUTOCAD",
        "startup_wait_time": 20,
        "command_delay": 0.5,
        "command_timeout": 10
    },
    "output": {
        "directory": "./output",
        "default_filename": "cad_drawing.dwg"
    },
    "work": {
        "directory": "C:\\arcaid\\work"
    },
    "egress": {
        "file": "config/egress.yaml"
    }
}
